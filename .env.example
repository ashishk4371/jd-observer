# Safe Environment Variables Example Template
# Copy this file to .env and insert your personal API key(s) if needed

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fully local, free, no API key: run Ollama (https://ollama.com) on this machine,
# `ollama pull llama3.1` (or any model you prefer), then either:
#   - select "Ollama (Local, Free)" in the extension and type the model name there, or
#   - uncomment OLLAMA_MODEL below to make Ollama the server-side default/fallback.
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
